# Copy this file to ".env" and fill in your real keys.
# (.env is git-ignored; .env.example is safe to commit as a template.)

FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# Which LLM runs the agents: groq (default), azure or anthropic.
LLM_PROVIDER=groq

# LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-key-here

# LLM_PROVIDER=azure  (Azure portal > your Foundry/OpenAI resource > Keys and Endpoint)
# Project-specific names so they don't clash with machine-wide AZURE_OPENAI_* vars.
AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_LLM_API_KEY=your-azure-openai-key
AZURE_LLM_DEPLOYMENT=gpt-4.1-mini
AZURE_LLM_API_VERSION=2024-10-21

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
